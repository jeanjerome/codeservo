{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeServo gate observation",
  "description": "The structured document a gate declaring result_format = \"codeservo-json\" writes where the controller told it to: a shell gate is given the location in $CODESERVO_OBSERVATION_PATH, a provider task as its one argument. The exit code remains the verdict; this document says what was measured. A gate declaring result_format = \"junit-xml\" writes nothing here: the controller projects the JUnit XML reports its tool wrote onto this same shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sensor", "status", "summary", "findings", "metrics"],
  "properties": {
    "schema_version": { "const": 1 },
    "sensor": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "path", "line", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor", "info"]
          },
          "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    }
  }
}
